#!/usr/bin/env bash
# muxloc-herdr -- herdr backend for muxloc.
#
# Usage: muxloc-herdr <active|session|window|pane|panes|agent>
#   active   exit 0 when running inside a herdr pane
#   session  workspace label
#   window   tab label, else tab number
#   pane     pane label, else its position in the tab
#   panes    number of panes in the tab
#   agent    coding agent herdr detected in the pane
#   title    terminal title of the pane
#   autoname "yes" while the tab label is still herdr's default number
#   rename <name>  set the tab label

# Executable only: sourcing would leak its functions/variables into your
# shell and its `exit` would close it.
if (return 0 2>/dev/null); then
  echo "muxloc-herdr: run it, don't source it" >&2
  return 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

active() {
  [ -n "${HERDR_PANE_ID:-}" ] && [ -n "${HERDR_TAB_ID:-}" ] \
    && [ -n "${HERDR_WORKSPACE_ID:-}" ] && have herdr && have jq
}

active || exit 1

# Ask herdr which pane this is. The HERDR_* ids are fixed when the pane
# starts and go stale once its tab is moved to another workspace.
read -r ws tab pane < <(herdr pane current 2>/dev/null \
  | jq -r '.result.pane | "\(.workspace_id) \(.tab_id) \(.pane_id)"')
[ -n "${pane:-}" ] && [ "$pane" != null ] \
  || { ws=$HERDR_WORKSPACE_ID tab=$HERDR_TAB_ID pane=$HERDR_PANE_ID; }

case "${1:-}" in
  active) exit 0 ;;
  session)
    herdr workspace get "$ws" 2>/dev/null \
      | jq -r '.result.workspace.label // empty'
    ;;
  window)
    herdr tab get "$tab" 2>/dev/null \
      | jq -r '.result.tab.label // .result.tab.number // empty'
    ;;
  panes)
    herdr tab get "$tab" 2>/dev/null \
      | jq -r '.result.tab.pane_count // empty'
    ;;
  pane)
    herdr pane list --workspace "$ws" 2>/dev/null \
      | jq -r --arg t "$tab" --arg p "$pane" '
          [.result.panes[] | select(.tab_id == $t)] as $ps
          | ($ps | map(.pane_id) | index($p)) as $i
          | if $i == null then empty
            else ($ps[$i].label // ($i + 1 | tostring)) end'
    ;;
  agent)
    herdr pane get "$pane" 2>/dev/null \
      | jq -r '.result.pane.agent // empty'
    ;;
  title)
    herdr pane get "$pane" 2>/dev/null \
      | jq -r '.result.pane.terminal_title_stripped // empty'
    ;;
  autoname)
    herdr tab get "$tab" 2>/dev/null \
      | jq -r '.result.tab.label // empty | select(test("^[0-9]+$")) | "yes"'
    ;;
  rename)
    [ -n "${2:-}" ] || exit 1
    herdr tab rename "$tab" "$2" >/dev/null
    ;;
  *) exit 1 ;;
esac
