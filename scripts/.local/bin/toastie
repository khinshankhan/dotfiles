#!/usr/bin/env bash
# toastie -- desktop notification from the shell, macOS or Linux.
#
# Usage: toastie [options] <title> [body]
#   -s, --subtitle TEXT  second line, between title and body
#   -c, --on-click CMD   shell command to run when the banner is clicked
#   -a, --activate ID    app to bring to the front on click, by bundle id (eg
#                        com.mitchellh.ghostty; $__CFBundleIdentifier is the
#                        terminal you're in)
#   -g, --group ID       replace an earlier banner with the same ID instead of
#                        stacking another one
#   -h, --help           this text
#
# Backends, first that fits:
#   osascript          macOS default. Delivers as Script Editor, so banners
#                      are held back in a Focus mode unless Script Editor is
#                      allowed there. Can't do --on-click, --activate or
#                      --group.
#   terminal-notifier  macOS, used when one of those asks for it (and it's
#                      installed); otherwise falls back to osascript. Delivers
#                      as terminal-notifier, with its own notification and
#                      Focus settings
#   notify-send        Linux; --on-click and --group are ignored
# With none available it does nothing and exits 0, so callers never break.

# Executable only: sourcing would leak its functions/variables into your
# shell and its `exit` would close it.
if (return 0 2>/dev/null); then
  echo "toastie: run it, don't source it" >&2
  return 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

subtitle="" on_click="" activate="" group=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s | --subtitle) subtitle="${2-}"; shift 2 ;;
    -c | --on-click) on_click="${2-}"; shift 2 ;;
    -a | --activate) activate="${2-}"; shift 2 ;;
    -g | --group) group="${2-}"; shift 2 ;;
    -h | --help)
      sed -n '2,/^$/{/^$/d; s/^# \{0,1\}//; p;}' "$0"
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "toastie: unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

title="${1-}" body="${2-}"
[ -n "$title" ] || { echo "toastie: needs a title (see toastie --help)" >&2; exit 1; }

# Plain macOS banner; the fallback when terminal-notifier can't deliver.
osascript_banner() {
  # Text goes in as argv, so quotes in the message need no escaping.
  osascript - "$title" "$subtitle" "$body" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set {t, s, b} to {item 1 of argv, item 2 of argv, item 3 of argv}
  if s is "" then
    display notification b with title t
  else
    display notification b with title t subtitle s
  end if
end run
APPLESCRIPT
}

if [ -n "$on_click$activate$group" ] && have terminal-notifier; then
  args=(-title "$title" -message "${body:- }")
  [ -n "$subtitle" ] && args+=(-subtitle "$subtitle")
  [ -n "$on_click" ] && args+=(-execute "$on_click")
  [ -n "$activate" ] && args+=(-activate "$activate")
  [ -n "$group" ] && args+=(-group "$group")
  # With a click action it stays running until the banner is clicked or
  # dismissed, so leave it in the background rather than block the caller.
  # It fails fast instead (eg exit 3 while its notifications are turned off
  # in System Settings), and then the banner goes out without the click.
  nohup terminal-notifier "${args[@]}" >/dev/null 2>&1 &
  pid=$!
  sleep 0.3
  if ! kill -0 "$pid" 2>/dev/null && ! wait "$pid" && have osascript; then
    osascript_banner
  fi
elif have osascript; then
  osascript_banner
elif have notify-send; then
  notify-send "$title" "${subtitle:+$subtitle
}$body"
fi
exit 0
