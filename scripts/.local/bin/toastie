#!/usr/bin/env bash
# toastie -- desktop notification from the shell, macOS or Linux.
#
# Usage: toastie [-s subtitle] [-u urgency] [-a app] <title> [body]
#   -s, --subtitle TEXT  second line, between title and body
#   -u, --urgency LEVEL  low, normal or critical (notify-send only)
#   -a, --app NAME       sending app's name, eg for dunst rules (notify-send only)
#   -h, --help           this text
#
# Backends, first that fits:
#   osascript    macOS. Delivers as Script Editor, so banners are held back in
#                a Focus mode unless Script Editor is allowed there
#   notify-send  Linux
# With neither available it does nothing and exits 0, so callers never break.

# Executable only: sourcing would leak its functions/variables into your
# shell and its `exit` would close it.
if (return 0 2>/dev/null); then
  echo "toastie: run it, don't source it" >&2
  return 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

subtitle="" urgency="" app=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s | --subtitle) subtitle="${2-}"; shift 2 ;;
    -u | --urgency) urgency="${2-}"; shift 2 ;;
    -a | --app) app="${2-}"; shift 2 ;;
    -h | --help)
      sed -n '2,/^$/{/^$/d; s/^# \{0,1\}//; p;}' "$0"
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "toastie: unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

title="${1-}" body="${2-}"
[ -n "$title" ] || { echo "toastie: needs a title (see toastie --help)" >&2; exit 1; }

if have osascript; then
  # Text goes in as argv, so quotes in the message need no escaping.
  osascript - "$title" "$subtitle" "$body" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set {t, s, b} to {item 1 of argv, item 2 of argv, item 3 of argv}
  if s is "" then
    display notification b with title t
  else
    display notification b with title t subtitle s
  end if
end run
APPLESCRIPT
elif have notify-send; then
  opts=()
  [ -n "$urgency" ] && opts+=(--urgency="$urgency")
  [ -n "$app" ] && opts+=(--app-name="$app")
  # Tagged so a server can style toasts apart from other apps: dunstrc's
  # [toastie] rule sets the title in medium weight, under the bold subtitle.
  opts+=(--category=x-toastie)
  # Servers like dunst read the text as Pango markup, so escape it (a stray <
  # or & in an agent's reply would otherwise garble the banner) and bold the
  # subtitle, the line that says what happened.
  esc() {
    local s="${1//&/\&amp;}"
    s="${s//</\&lt;}"
    printf '%s' "${s//>/\&gt;}"
  }
  notify-send "${opts[@]}" "$(esc "$title")" "${subtitle:+<b>$(esc "$subtitle")</b>
}$(esc "$body")"
fi
exit 0
