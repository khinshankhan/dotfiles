#!/usr/bin/env bash
# muxloc -- where is this terminal? One answer across multiplexers.
#
# Usage: muxloc [field]           print a field (default: where)
#        muxloc <action> [arg]    change this tab/window
#
# Fields:
#   mux            which multiplexer is active, eg herdr or tmux
#   session        herdr workspace / tmux session
#   window         herdr tab / tmux window
#   pane           pane label or position within the tab/window
#   panes          how many panes share this tab/window
#   where          session:window, plus .pane when the tab/window is split
#   title          terminal title of this pane, as set by the app (eg Claude)
#   autoname       "yes" while the tab/window still has its default name
#   id             stable handle for this pane, eg herdr:wB:pG, for focus
#
# Actions:
#   rename <name>  rename this tab/window
#   reset-name     restore the default name, so autoname says "yes" again
#   focus <id>     jump to the pane an earlier `muxloc id` named. Works from
#                  anywhere, eg a notification click outside any multiplexer
#
#   help           this text (also -h, --help)
#
# Backends are muxloc-<mux> scripts on PATH (muxloc-herdr, muxloc-tmux, ...),
# each answering `active` plus the fields and actions above. The first active
# one wins: $order first, then any other muxloc-* on PATH. tmux goes before
# herdr, so a tmux session started inside a herdr pane (eg the temporal
# scripts) reports the tmux location.
#
# A field prints its value and exits 0, or prints nothing and exits 1 when no
# backend is active or the field is unknown there.

# Executable only: sourcing would leak its functions/variables into your
# shell and its `exit` would close it.
if (return 0 2>/dev/null); then
  echo "muxloc: run it, don't source it" >&2
  return 1
fi

# Help is the header comment above, minus the leading "# ".
case "${1:-}" in
  -h | --help | help)
    sed -n '2,/^$/{/^$/d; s/^# \{0,1\}//; p;}' "$0"
    exit 0
    ;;
esac

order="tmux herdr"

have() { command -v "$1" >/dev/null 2>&1; }

# Backend names, preferred ones first, each listed once.
backends() {
  { printf '%s\n' $order; compgen -c muxloc- | sed 's/^muxloc-//'; } \
    | awk '!seen[$0]++'
}

get() { "muxloc-$mux" "$@" 2>/dev/null; }

# focus runs from anywhere, so it can't detect a backend from the
# environment; the id names its multiplexer instead ("<mux>:<backend id>").
if [ "${1:-}" = focus ]; then
  id="${2:-}" m="${2%%:*}"
  [ -n "$id" ] && [ "$m" != "$id" ] && have "muxloc-$m" || exit 1
  exec "muxloc-$m" focus "${id#*:}"
fi

# session:window, plus .pane when the tab/window is split.
where() {
  local s w p
  s="$(get session)" w="$(get window)"
  [ -n "$s" ] && [ -n "$w" ] || return
  if [ "$(get panes)" -gt 1 ] 2>/dev/null && p="$(get pane)" && [ -n "$p" ]
  then
    echo "$s:$w.$p"
  else
    echo "$s:$w"
  fi
}

mux=""
for m in $(backends); do
  have "muxloc-$m" && "muxloc-$m" active && mux="$m" && break
done
[ -n "$mux" ] || exit 1

case "${1:-where}" in
  mux) out="$mux" ;;
  where) out="$(where)" ;;
  session | window | pane | panes | title | autoname) out="$(get "$1")" ;;
  id) out="$(get id)" && out="$mux:$out" ;;
  rename)
    [ -n "${2:-}" ] || exit 1
    get rename "$2"
    exit
    ;;
  reset-name)
    get reset-name
    exit
    ;;
  *) exit 1 ;;
esac

[ -n "$out" ] || exit 1
printf '%s\n' "$out"
