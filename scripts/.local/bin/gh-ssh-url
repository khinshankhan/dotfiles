#!/usr/bin/env bash
set -euo pipefail

main() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: $(basename "$0") <github-url-or-owner/repo>" >&2
    return 1
  fi

  case "$1" in
    -h|--help)
      echo "Usage: $(basename "$0") <github-url-or-owner/repo>"
      echo ""
      echo "Print the SSH clone URL for a GitHub repository."
      return 0
      ;;
  esac

  local input="$1"
  local normalized="${input%%#*}"
  normalized="${normalized%%\?*}"

  local owner=""
  local repo=""

  if [[ "$normalized" =~ ^https?://github\.com/([^/]+)/([^/]+)(/.*)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "$normalized" =~ ^github\.com/([^/]+)/([^/]+)(/.*)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "$normalized" =~ ^git@github\.com:([^/]+)/([^/]+)(\.git)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  elif [[ "$normalized" =~ ^([^/]+)/([^/]+)$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  else
    echo "Invalid input. Expected GitHub URL or owner/repo." >&2
    return 1
  fi

  repo="${repo%.git}"

  echo "git@github.com:${owner}/${repo}.git"
}

main "$@"
