#!/usr/bin/env bash
set -euo pipefail

# Create directories that multiple stow packages (eg. public and private dotfiles)
# need to coexist in. Without these, stow will symlink the entire directory to one
# package, preventing others from stowing into the same path.

setup_dirs() {
    local dirs=(
        "$HOME/.emacs.d"
        "$HOME/.config"
        "$HOME/.config/git"
        "$HOME/.config/shell"
        "$HOME/.local/bin"
        "$HOME/.local/share"
        "$HOME/.local/state"
    )

    for dir in "${dirs[@]}"; do
        mkdir -p "$dir"
        touch "$dir/.keep"
    done
}

setup_dirs
