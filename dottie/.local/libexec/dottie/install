#!/usr/bin/env bash
# Stow every package (or the named ones) from this repo into $HOME.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
cd "$DOTFILES"

# Non-package top-level dirs are listed in the repo-root .stow-local-ignore
# (one dir name per line, # comments ok). Build a newline-delimited ignore set
# (avoids bash 4 associative arrays -- macOS ships bash 3.2). .git is always in.
ignore=$'\n.git\n'
if [ -f .stow-local-ignore ]; then
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | tr -d '[:space:]')"
        [ -n "$line" ] && ignore="$ignore$line"$'\n'
    done < .stow-local-ignore
fi
is_ignored() { case "$ignore" in *$'\n'"$1"$'\n'*) return 0 ;; *) return 1 ;; esac; }

# In a git repo, only top-level dirs with tracked files count as packages, so
# scratch dirs (notes/, a half-made package) never leak into $HOME by default.
tracked=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tracked=$'\n'"$(git ls-files | cut -d/ -f1 | sort -u)"$'\n'
fi
is_untracked() {
    [ -n "$tracked" ] || return 1
    case "$tracked" in *$'\n'"$1"$'\n'*) return 1 ;; *) return 0 ;; esac
}

# Packages: dirs given as args, or every tracked top-level dir not in the ignore
# set. Named packages are taken as given (untracked ones included) but must exist.
pkgs=()
if [ "$#" -gt 0 ]; then
    for d in "$@"; do
        d="${d%/}"
        if [ ! -d "$d" ]; then
            echo "dottie install: no package '$d' in $DOTFILES" >&2
            exit 1
        fi
        pkgs+=("$d")
    done
else
    for d in */; do
        # no match -> literal glob, skip
        [ -d "$d" ] || continue
        d="${d%/}"
        is_ignored "$d" && continue
        if is_untracked "$d"; then
            echo "dottie install: skipping untracked dir '$d' (name it to stow anyway)" >&2
            continue
        fi
        pkgs+=("$d")
    done
fi

# Never call stow with an empty package list -- that would operate on the cwd and
# can unstow existing links. Bail clearly instead.
if [ "${#pkgs[@]}" -eq 0 ]; then
    echo "dottie install: no packages to stow in $DOTFILES" >&2
    exit 1
fi

stow -Rvt ~ "${pkgs[@]}"
