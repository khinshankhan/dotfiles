#!/usr/bin/env bash
# Stow explicitly named packages or a machine list into $HOME.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
cd "$DOTFILES"

# Non-package top-level dirs are listed in the repo-root .stow-local-ignore
# (one dir name per line, # comments ok). Build a newline-delimited ignore set
# (avoids bash 4 associative arrays -- macOS ships bash 3.2). .git is always in.
ignore=$'\n.git\n'
if [ -f .stow-local-ignore ]; then
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | tr -d '[:space:]')"
        [ -n "$line" ] && ignore="$ignore$line"$'\n'
    done < .stow-local-ignore
fi
is_ignored() { case "$ignore" in *$'\n'"$1"$'\n'*) return 0 ;; *) return 1 ;; esac; }

usage() {
    echo "usage: dottie install [--dry-run] <package> [package...]"
    echo "       dottie install --machine <name> [--dry-run|--apply]"
    echo "machine lists: $DOTFILES/packages/<name>/dotfiles.list"
    cat <<'EOF'

Named packages apply by default; add --dry-run to preview.
Machine lists preview by default; add --apply to install.
Flags may appear before or after package names. Do not combine --dry-run
and --apply, or mix named packages with --machine.

Machine lists contain one package name per line, with optional # comments
and blank lines. Missing, empty, or invalid lists fail without changing links.
Packages omitted from a list are not uninstalled.

examples:
  dottie install git tmux --dry-run
  dottie install git tmux
  dottie install --machine gengar
  dottie install --machine gengar --apply

Run dottie prestow before installation to prepare shared directories.
EOF
}

pkgs=()
machine=""
mode=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dry-run|--apply)
            if [ -n "$mode" ] && [ "$mode" != "$1" ]; then
                echo "dottie install: --dry-run and --apply cannot be combined" >&2
                exit 1
            fi
            mode="$1"
            shift ;;
        --machine)
            if [ "$#" -lt 2 ] || [ -n "$machine" ]; then
                usage >&2
                exit 1
            fi
            case "$2" in
                ""|.*|*[!a-zA-Z0-9_-]*)
                    echo "dottie install: invalid machine name '$2'" >&2
                    exit 1 ;;
            esac
            machine="$2"
            shift 2 ;;
        -*) echo "dottie install: unknown option '$1'" >&2; exit 1 ;;
        *) pkgs+=("$1"); shift ;;
    esac
done

if [ -n "$machine" ]; then
    if [ "${#pkgs[@]}" -gt 0 ]; then
        echo "dottie install: choose packages or --machine, not both" >&2
        exit 1
    fi
    mode="${mode:---dry-run}"
    manifest="$DOTFILES/packages/$machine/dotfiles.list"
    if [ ! -f "$manifest" ]; then
        echo "dottie install: no machine list at $manifest" >&2
        exit 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$line" ] && pkgs+=("$line")
    done < "$manifest"
fi
mode="${mode:---apply}"

# Validate the entire selection before Stow can change any links. Accept only
# top-level package names, never paths or Stow options.
if [ "${#pkgs[@]}" -eq 0 ]; then
    echo "dottie install: no packages selected" >&2
    usage >&2
    exit 1
fi
for d in "${pkgs[@]}"; do
    case "$d" in
        .*|-*|*/*|*[!a-zA-Z0-9_.-]*)
            echo "dottie install: invalid package name '$d'" >&2
            exit 1 ;;
    esac
    if is_ignored "$d" || [ ! -d "$d" ]; then
        echo "dottie install: no package '$d' in $DOTFILES" >&2
        exit 1
    fi
done

stow_flags=(-Rvt)
if [ "$mode" = --dry-run ]; then
    stow_flags=(-nRvt)
    echo "dottie install: preview only; no links will be changed"
fi
stow "${stow_flags[@]}" "$HOME" "${pkgs[@]}"

# Remember the machine an applied list was for, so `dottie doctor` can check
# against it without being told (machine names needn't match the hostname).
if [ -n "$machine" ] && [ "$mode" = --apply ]; then
    state="${XDG_STATE_HOME:-$HOME/.local/state}/dottie"
    mkdir -p "$state" && printf '%s\n' "$machine" > "$state/machine"
fi
