{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 45,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log *)",
      "Bash(git push*)",
      "Bash(grep *)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:nixos.wiki)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_wait_for"
    ],
    "deny": [
      "Bash(git checkout * --force*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout .*)",
      "Bash(git checkout HEAD --*)",
      "Bash(git clean*)",
      "Bash(git reset * --hard*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --keep*)",
      "Bash(git reset --merge*)",
      "Bash(git restore*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch --force*)",
      "Bash(git switch -f*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit * --fixup=amend*)",
      "Bash(git commit * --fixup=reword*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --fixup=amend*)",
      "Bash(git commit --fixup=reword*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git gc --prune*)",
      "Bash(git prune*)",
      "Bash(git rebase * --root*)",
      "Bash(git rebase --root*)",
      "Bash(git reflog delete*)",
      "Bash(git reflog expire*)",
      "Bash(git replace*)",
      "Bash(git update-ref*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push * --force*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * -d *)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push --force*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --prune*)",
      "Bash(git push --prune*)",
      "Bash(git push -d *)",
      "Bash(git push -f*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --force*)",
      "Bash(git branch -D*)",
      "Bash(git branch -f*)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)",
      "Bash(git tag --delete*)",
      "Bash(git tag -d*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git add --all*)",
      "Bash(git add -A*)",
      "Bash(git add . *)",
      "Bash(git add .)",
      "Bash(git add ./notes*)",
      "Bash(git add notes*)",
      "Bash(git -C * checkout -- *)",
      "Bash(git -C * checkout -f*)",
      "Bash(git -C * checkout .*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * restore*)",
      "Bash(git -C * switch --discard-changes*)",
      "Bash(git -C * switch -f*)",
      "Bash(git -C * commit * --amend*)",
      "Bash(git -C * commit --amend*)",
      "Bash(git -C * filter-branch*)",
      "Bash(git -C * filter-repo*)",
      "Bash(git -C * gc --prune*)",
      "Bash(git -C * prune*)",
      "Bash(git -C * rebase --root*)",
      "Bash(git -C * reflog expire*)",
      "Bash(git -C * replace*)",
      "Bash(git -C * update-ref*)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * push * --delete*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push --delete*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push --mirror*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * branch -D*)",
      "Bash(git -C * branch -f*)",
      "Bash(git -C * stash clear*)",
      "Bash(git -C * stash drop*)",
      "Bash(git -C * tag -d*)",
      "Bash(git -C * add --all*)",
      "Bash(git -C * add -A*)",
      "Bash(git -C * add . *)",
      "Bash(git -C * add .)",
      "Bash(git -C * add notes*)",
      "Bash(gh repo delete*)",
      "Bash(/bin/rm -R*)",
      "Bash(/bin/rm -f*r*)",
      "Bash(/bin/rm -r*)",
      "Bash(command rm -r*)",
      "Bash(rm * --recursive*)",
      "Bash(rm * -R*)",
      "Bash(rm * -f*r*)",
      "Bash(rm * -r*)",
      "Bash(rm --recursive*)",
      "Bash(rm -R*)",
      "Bash(rm -f*R*)",
      "Bash(rm -f*r*)",
      "Bash(rm -r*)",
      "Bash(sudo rm*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(find * -execdir rm*)",
      "Bash(shred*)",
      "Bash(srm*)",
      "Bash(xargs -0 rm*)",
      "Bash(xargs rm*)"
    ],
    "ask": [
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git reset*)",
