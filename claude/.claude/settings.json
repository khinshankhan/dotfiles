{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 45,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:nixos.wiki)"
    ],
    "deny": [
      "Bash(gh repo delete*)"
    ],
    "ask": [
      "Bash(gh repo create*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh gist create*)",
      "Bash(gh gist edit*)",
      "Bash(gh gist delete*)",
      "Bash(gh gist clone*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release delete*)",
      "Bash(gh release upload*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh label delete*)",
      "Bash(gh label clone*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret remove*)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh run cancel*)",
      "Bash(gh run rerun*)",
      "Bash(gh run delete*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(gh pr create* -R *)",
      "Bash(gh pr create* --repo*)",
      "Bash(gh pr comment* -R *)",
      "Bash(gh pr comment* --repo*)",
      "Bash(gh pr review* -R *)",
      "Bash(gh pr review* --repo*)",
      "Bash(gh pr edit* -R *)",
      "Bash(gh pr edit* --repo*)",
      "Bash(gh pr close* -R *)",
      "Bash(gh pr close* --repo*)",
      "Bash(gh pr reopen* -R *)",
      "Bash(gh pr reopen* --repo*)",
      "Bash(gh pr ready* -R *)",
      "Bash(gh pr ready* --repo*)",
      "Bash(gh issue create* -R *)",
      "Bash(gh issue create* --repo*)",
      "Bash(gh issue comment* -R *)",
      "Bash(gh issue comment* --repo*)",
      "Bash(gh issue edit* -R *)",
      "Bash(gh issue edit* --repo*)",
      "Bash(gh issue close* -R *)",
      "Bash(gh issue close* --repo*)",
      "Bash(gh issue reopen* -R *)",
      "Bash(gh issue reopen* --repo*)",
      "Bash(gh api* -X POST*)",
      "Bash(gh api* --method POST*)",
      "Bash(gh api* -X PUT*)",
      "Bash(gh api* --method PUT*)",
      "Bash(gh api* -X PATCH*)",
      "Bash(gh api* --method PATCH*)",
      "Bash(gh api* -X DELETE*)",
      "Bash(gh api* --method DELETE*)",
      "Bash(gh api* -X post*)",
      "Bash(gh api* --method post*)",
      "Bash(gh api* -X put*)",
      "Bash(gh api* --method put*)",
      "Bash(gh api* -X patch*)",
      "Bash(gh api* --method patch*)",
      "Bash(gh api* -X delete*)",
      "Bash(gh api* --method delete*)",
      "Bash(gh api* -f *)",
      "Bash(gh api* -F *)",
      "Bash(gh api* --field*)",
      "Bash(gh api* --raw-field*)",
      "Bash(gh api* --input*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude blocked chime",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude blocked toast",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done chime",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done toast",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done tab-rename",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "viewMode": "default",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "prefersReducedMotion": false,
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true
}
