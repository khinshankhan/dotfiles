      "Bash(git branch * origin/*)",
      "Bash(git branch * upstream/*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git apply*)",
      "Bash(git am*)",
      "Bash(git submodule*)",
      "Bash(git config --global*)",
      "Bash(git config --unset*)",
      "Bash(git remote add*)",
      "Bash(git remote remove*)",
      "Bash(git remote set-url*)",
      "Bash(git -c *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git -C * pull*)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * merge*)",
      "Bash(git -C * cherry-pick*)",
      "Bash(git -C * revert*)",
      "Bash(git -C * reset*)",
      "Bash(git -C * checkout*)",
      "Bash(git -C * stash*)",
      "Bash(git -C * branch -d*)",
      "Bash(git -C * branch --delete*)",
      "Bash(git -C * branch -m*)",
      "Bash(git -C * branch -M*)",
      "Bash(git -C * branch --track*)",
      "Bash(git -C * tag*)",
      "Bash(git -C * worktree*)",
      "Bash(git -C * rm*)",
      "Bash(git -C * mv*)",
      "Bash(git -C * apply*)",
      "Bash(git -C * am*)",
      "Bash(git -C * submodule*)",
      "Bash(git -C * config*)",
      "Bash(git -C * remote*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr reopen*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr checkout*)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue delete*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo fork*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh run cancel*)",
      "Bash(gh run rerun*)",
      "Bash(gh run delete*)",
      "Bash(gh api -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api * --input*)",
      "Bash(rm *)",
      "Bash(/bin/rm *)",
      "Bash(command rm *)",
      "Bash(rmdir*)",
      "Bash(unlink*)",
      "Bash(truncate*)",
      "Bash(sudo *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:master*)",
      "Bash(git -C * push * main*)",
      "Bash(git -C * push * master*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude blocked chime",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude blocked toast",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done chime",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done toast",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.agents/hooks/agent-event.sh claude done tab-rename",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "viewMode": "default",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "awaySummaryEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "prefersReducedMotion": false,
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true
}
