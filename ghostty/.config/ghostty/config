# ported from the wezterm and warp configs in this repo, so all three
# terminals look and behave the same. only settings that differ from the
# defaults are here -- `ghostty +show-config --default --docs` has the rest.
#
# one file for both platforms. ghostty has no os conditionals, but macos-*
# keys are ignored on linux and gtk-* keys are ignored on macos, so each
# platform only sees its own half. keybinds that differ per platform are
# listed with both modifiers.

# same fallback chain as wezterm.lua. ghostty falls through the list per
# glyph, so the nerd font first means icons resolve without a patched fallback
font-family = Hack Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
font-family = Fira Code
font-family = Source Code Pro
font-size = 16

# no ligatures, matching warp. keeps != and -> from fusing
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# one dark-ish palette, carried over from wezterm.lua
background = #272a30
foreground = #d4d4d4
cursor-color = #d4d4d4
cursor-text = #272a30
selection-background = #3d4148
split-divider-color = #21242a

palette = 0=#1e2127
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#ffffff

# warp only bumped contrast on named colors. ghostty applies this everywhere,
# so keep it low or it washes out the palette above
minimum-contrast = 1.1

# no padding, and as little window chrome as tabs allow on each platform.
# `window-decoration = none` is deliberately not used: on macos it disables
# tabs outright, and `macos-titlebar-style = hidden` does the same
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# linux: i3 draws the border, gtk keeps its header bar out of the way and
# colors the tab bar from the palette above
gtk-titlebar = false
gtk-wide-tabs = false
window-theme = ghostty

# macos: tabs live in the titlebar, so keep a titlebar but make it a tab strip
# painted in the terminal background, with no traffic lights
macos-titlebar-style = tabs
macos-window-buttons = hidden
window-save-state = always

# steady bar, no blink. wezterm and warp both agreed on this
cursor-style = bar
cursor-style-blink = false

# NOTE: this is a byte budget per surface, not a line count like wezterm's
# scrollback_lines. 64mb is roughly warp's 50k-line grid
scrollback-limit = 67108864
scrollbar = never
mouse-hide-while-typing = true
unfocused-split-opacity = 1.0

# system clipboard on select, not just the x11 primary selection
copy-on-select = clipboard

# tell me when something long finishes while i'm in another window
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s

# send alt/meta instead of composing macos special characters, so terminal
# apps can bind option+key. without this, option+o types "ø" and option+[
# types a curly quote, and tmux never sees a keypress at all. inert on linux
macos-option-as-alt = true

# keybinds. wezterm used cmd on macos and ctrl+shift on linux. ghostty's macos
# defaults already match the cmd set (cmd+d / cmd+shift+d splits, cmd+[ and
# cmd+] between splits, cmd+w close, cmd+t tab, cmd+1..8 tabs, cmd+9 last
# tab, cmd+k clear, cmd+ctrl+f fullscreen), so only the linux side needs
# help. ctrl+shift+w, ctrl+shift+t, ctrl+shift+p and alt+1..9 are already
# linux defaults and are not repeated here
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+alt+d=new_split:down
keybind = ctrl+shift+bracket_left=goto_split:previous
keybind = ctrl+shift+bracket_right=goto_split:next
# directional split moves. `performable:` sends the key through to the shell
# when there is no split that way, so emacs and tmux still see ctrl+shift+arrow
# in a lone pane. this shadows ghostty's linux default of ctrl+shift+left and
# ctrl+shift+right for previous and next tab -- ctrl+page up/down and alt+1..9
# still switch tabs
keybind = performable:ctrl+shift+arrow_up=goto_split:up
keybind = performable:ctrl+shift+arrow_down=goto_split:down
keybind = performable:ctrl+shift+arrow_left=goto_split:left
keybind = performable:ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+alt+z=toggle_split_zoom
keybind = ctrl+shift+alt+e=equalize_splits
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+k=clear_screen

# cmd+s (pressed with right cmd) is the herdr prefix: send what ctrl+enter
# sends (CSI 13;5u), herdr's configured prefix, so either chord works.
# ghostty can't tell left cmd from right; the right-hand habit keeps a
# reflexive left cmd+s "save" from landing in herdr. cmd+s is unbound in
# ghostty, so nothing is lost.
keybind = super+s=csi:13;5u
