#!/usr/bin/env bash
set -euo pipefail

ta() {
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ] || [[ "$1" =~ ^--?h(elp)?$ ]]; then
        echo "usage: ta <session>[:<window>] [path]" >&2
        echo "  Attach to (or create) a named tmux session." >&2
        echo "  If window is given, select that window after attaching." >&2
        echo "  If path is given, set the session's working directory." >&2
        return 2
    fi

    local target="$1"
    local session="${target%%:*}"
    local window="${target#*:}"
    [ "$window" = "$target" ] && window=""
    local dir="${2:+$(cd "$2" && pwd)}"

    local new_args=(-A -s "$session")
    [ -n "$dir" ] && new_args+=(-c "$dir")
    [ -n "$window" ] && new_args+=(-n "$window")

    if tmux has-session -t "$session" 2>/dev/null; then
        # Session exists, so `new-session -A -c` would ignore -c. Persist the
        # dir as a session option; the new-window/split bindings in tmux.conf
        # read @ta_dir so windows created later open there regardless of which
        # pane #{pane_current_path} points at.
        [ -n "$dir" ] && tmux set-option -t "$session" @ta_dir "$dir"
        if [ -n "$window" ]; then
            if ! tmux select-window -t "$session:$window" 2>/dev/null; then
                tmux new-window -t "$session" -n "$window" ${dir:+-c "$dir"}
            fi
        fi
        tmux attach-session -t "$session"
    else
        tmux new-session "${new_args[@]}"
        [ -n "$dir" ] && tmux set-option -t "$session" @ta_dir "$dir"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then ta "$@"; fi
