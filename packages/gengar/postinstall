#!/usr/bin/env bash
# postinstall --- gengar (x86_64-linux, Arch)
#
# Run AFTER the package manifests are applied:
#   sudo pacman -S --needed - < packages/gengar/pkglist.pacman
#   yay        -S --needed - < packages/gengar/pkglist.aur
#   packages/gengar/postinstall          # <- you are here
#
# Home for the steps a package list can't express: initializing data dirs,
# enabling services, one-time system config. A pkglist installs bytes; this
# makes them run.
#
# Idempotent by construction -- every step checks before it acts, so re-running
# is safe and boring. Add steps as guarded blocks, not bare commands.

# Execute, don't source: this script flips shell options, opens fd 9 for the
# lock, and names variables (PGDATA) that must not land in a live shell.
if (return 0 2>/dev/null); then
    echo "postinstall must be executed, not sourced" >&2
    return 1
fi
set -euo pipefail

log() {
    printf '\033[1;34m==>\033[0m %s\n' "$*";
}
skip() {
    printf '\033[1;30m--\033[0m %s\n' "$*";
}
have() {
    command -v "$1" >/dev/null 2>&1;
}

# Serialize overlapping runs. Every step is idempotent, but the guards are
# check-then-act, so two simultaneous runs could race (worst case: dueling
# initdb on a virgin data dir). Late runs wait their turn, then skip through.
# flock ships in util-linux, part of base -- not a dep worth declaring.
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/gengar-postinstall.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    log "another run holds $LOCKFILE; waiting for it to finish"
    flock 9
fi

# postgresql: init the data dir, then enable the service
# The package ships the binaries but not a database cluster; Arch leaves initdb
# to you. Without this, `systemctl start postgresql` fails on an empty data dir.
if have postgres; then
    PGDATA=/var/lib/postgres/data
    if [ ! -s "$PGDATA/PG_VERSION" ]; then
        log "postgresql: initializing cluster at $PGDATA"
        sudo -u postgres initdb --locale=C.UTF-8 --encoding=UTF8 -D "$PGDATA"
    else
        skip "postgresql: cluster already initialized"
    fi

    if systemctl is-enabled --quiet postgresql 2>/dev/null \
        && systemctl is-active --quiet postgresql; then
        skip "postgresql: service already enabled + running"
    else
        log "postgresql: enabling + starting service"
        sudo systemctl enable --now postgresql
    fi
else
    skip "postgresql: not installed, nothing to init"
fi

# postgis: enable the extension where it's wanted
# The package only drops files into /usr/lib/postgresql; every database opts in
# with CREATE EXTENSION. Enable it in template1 so future `createdb`s inherit
# it, and in postgres so scratch queries work out of the box.
# NB: after pacman upgrades postgis, run `SELECT postgis_extensions_upgrade();`
# per database -- that's maintenance, not install, so it doesn't live here.
if have postgres && systemctl is-active --quiet postgresql; then
    if sudo -u postgres psql -tAc \
        "SELECT 1 FROM pg_available_extensions WHERE name = 'postgis'" | grep -q 1; then
        for db in template1 postgres; do
            if sudo -u postgres psql -d "$db" -tAc \
                "SELECT 1 FROM pg_extension WHERE extname = 'postgis'" | grep -q 1; then
                skip "postgis: extension already enabled in $db"
            else
                log "postgis: CREATE EXTENSION postgis in $db"
                sudo -u postgres psql -d "$db" -c "CREATE EXTENSION IF NOT EXISTS postgis"
            fi
        done
    else
        skip "postgis: extension not available, nothing to enable"
    fi
else
    skip "postgis: postgresql not running, can't enable extension"
fi

# docker: enable the daemon, let $USER talk to it without sudo
# The socket is root-owned; membership in the docker group is the standard way
# in (and is root-equivalent -- known tradeoff on a single-user machine).
if have docker; then
    if systemctl is-enabled --quiet docker 2>/dev/null \
        && systemctl is-active --quiet docker; then
        skip "docker: service already enabled + running"
    else
        log "docker: enabling + starting service"
        sudo systemctl enable --now docker
    fi

    if id -nG "$USER" | grep -qw docker; then
        skip "docker: $USER already in docker group"
    else
        log "docker: adding $USER to docker group (takes effect next login)"
        sudo usermod -aG docker "$USER"
    fi
else
    skip "docker: not installed, nothing to enable"
fi
