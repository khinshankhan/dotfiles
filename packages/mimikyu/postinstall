#!/usr/bin/env bash
# postinstall --- mimikyu (macOS)
#
# Run AFTER the Brewfile is applied:
#   brew bundle --file=packages/mimikyu/Brewfile
#   packages/mimikyu/postinstall          # <- you are here
#
# Home for the steps a Brewfile can't express: linking app bundles Homebrew
# drops outside /Applications, one-time system config. A Brewfile installs
# bytes; this makes them visible.
#
# Idempotent by construction -- every step checks before it acts, so re-running
# is safe and boring. Add steps as guarded blocks, not bare commands.

set -euo pipefail

log() {
    printf '\033[1;34m==>\033[0m %s\n' "$*";
}
skip() {
    printf '\033[1;30m--\033[0m %s\n' "$*";
}
have() {
    command -v "$1" >/dev/null 2>&1;
}

# Where our own repos live. Steps that need a checkout clone under here.
PROJECTS_DIR="$HOME/development/khinshankhan"
[ -d "$PROJECTS_DIR" ] || mkdir -p "$PROJECTS_DIR"

# Where steps drop symlinks to things they build.
BIN_DIR="$HOME/.local/bin"
[ -d "$BIN_DIR" ] || mkdir -p "$BIN_DIR"

# emacs-mac: formula builds Emacs.app into the Cellar, but Spotlight/Launchpad
# only index /Applications and ~/Applications -- neither formula nor `brew
# bundle` puts it there. Symlink it into ~/Applications so it actually shows up.
EMACS_APP="$(brew --prefix emacs-mac@29 2>/dev/null)/Emacs.app"
EMACS_LINK="$HOME/Applications/Emacs.app"
if ! have brew; then
    skip "emacs-mac: brew missing, nothing to link"
elif [ -d "$EMACS_APP" ]; then
    if [ -L "$EMACS_LINK" ] && [ "$(readlink "$EMACS_LINK")" = "$EMACS_APP" ]; then
        skip "emacs-mac: ~/Applications/Emacs.app already linked"
    else
        log "emacs-mac: linking Emacs.app into ~/Applications"
        mkdir -p "$HOME/Applications"
        ln -sf "$EMACS_APP" "$EMACS_LINK"
    fi
else
    skip "emacs-mac: not installed, nothing to link"
fi

# yui: our own CLI, built from source and linked onto PATH
# Go project; `make build` drops binaries in bin/, which is gitignored -- so a
# fresh clone has nothing to link until we build. Only yui goes on PATH; the
# other services it builds (case, clip, color, net) stay in the repo.
# go comes from nix (modules.dev.go), so run `dottie nix apply` before this.
# SSH remote to match the existing checkout, so this needs keys loaded.
YUI_DIR="$PROJECTS_DIR/yui"
if ! have git || ! have go || ! have make; then
    skip "yui: git/go/make missing, can't build"
else
    if [ -d "$YUI_DIR/.git" ]; then
        skip "yui: repo already cloned"
    else
        log "yui: cloning repo"
        git clone git@github.com:khinshankhan/yui.git "$YUI_DIR"
    fi

    if [ -x "$YUI_DIR/bin/yui" ]; then
        skip "yui: already built"
    else
        log "yui: building"
        make -C "$YUI_DIR" build
    fi

    if [ -L "$BIN_DIR/yui" ]; then
        skip "yui: already linked into $BIN_DIR"
    else
        log "yui: linking into $BIN_DIR"
        ln -s "$YUI_DIR/bin/yui" "$BIN_DIR/yui"
    fi
fi
